# 复制为项目根目录下的 `.env` 后按需填写（勿提交真实密钥）。
#
# === 选品/编排等（ecommerce_agent.llm.OpenAICompatChatClient）===
# OpenAI 兼容网关：base 一般为「含 /v1」的根地址
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_CHAT_PATH=/chat/completions
# 读超时（秒）：选品 + 图谱链路易超过 60s，默认 120；仅想拉长「等首 token」可读 LLM_READ_TIMEOUT_S
# LLM_TIMEOUT_S=120
# LLM_READ_TIMEOUT_S=180
# LLM_CONNECT_TIMEOUT_S=30
# 单次回复最大 token（非流式）；建议 ≤4096，部分网关（如 Gitee AI）超过 4096 时必须 stream
# LLM_MAX_OUTPUT_TOKENS=4096
# LightRAG 内 llm_adapter 也会读此项并封顶到 4096；仅影响图谱内 LLM 调用
# LIGHTRAG_LLM_MAX_TOKENS=4096
#
# --- Gitee AI（若 LLM_BASE_URL=https://ai.gitee.com/v1）---
# 密钥须为 ai.gitee.com 工作台「设置 → 访问令牌」里创建的 Serverless API 令牌，
# 不要用 gitee.com 代码托管里的「私人令牌」。需已购买/充值 Serverless API，否则可能鉴权失败。
# LLM_API_KEY 只填令牌字符串，不要写「Bearer 」前缀（程序会自动加）。
# 若仍 HTTP 401：核对令牌是否复制完整、是否被撤销、账户余额与模型是否在控制台可用。

# === LightRAG：仅「嵌入」走 4zapi（抽取/问答 LLM 仍由 LLM_PROVIDER + 下方或 config 决定）===
# 必须同时设置 base + key 才会启用独立嵌入网关；不设置时嵌入逻辑与旧版一致（见 kg_builder）。
LIGHTRAG_EMBED_BASE_URL=https://4zapi.com/v1
LIGHTRAG_EMBED_API_KEY=
# 与网关实际提供的 embedding 模型名一致
LIGHTRAG_EMBED_MODEL=text-embedding-3-small

# === LightRAG 其它（无顶层 config.settings 时）===
# LLM_PROVIDER=openai
# EMBEDDING_TIMEOUT_SEC=180
# EMBEDDING_FUNC_MAX_ASYNC=4
# KG_ENGAGEMENT_DOC_MODE=tier
# LIGHTRAG_LANGUAGE=Simplified Chinese
#
# === kg_builder：LightRAG 包来源（与选品是否走图谱相关）===
# 不设或 0：优先用环境里 ``pip install lightrag`` 的包（避免被仓库 vendor 顶掉导致 Py3.9 导入失败）
# 设为 1/true：强制插入仓库内 ``ecommerce_agent/LightRAG`` 再导入（旧行为）
# ECOMMERCE_LIGHTRAG_VENDOR=0
#
# 仅允许 PyPI lightrag，导入失败时不回退 vendor（推荐与 Py3.9 或「只要官方包」一起用）
# ECOMMERCE_LIGHTRAG_PIP_ONLY=1
#
# 选品是否跳过图谱由 ``criteria["_skip_kg"]``（或需求文档解析结果）决定；编排器不再根据 find_spec 改写。
#
# === API 选品需求正文（与前端 POST /api/report 一致）===
# 不设：GET /api/report 仍用编排器内置 demo criteria；设长文请用 POST JSON 字段 ``selection_requirements``。
#
# === 淘宝竞品缓存（TaobaoCompetitorAdapter）===
# 抓取结果为 0 条时的缓存秒数（默认 120）；设为 0 表示不缓存空结果，每次都重新爬。
# TAOBAO_EMPTY_CACHE_TTL_SEC=120

# === 业务阈值：高退货红线（销量复盘 / 行动清单 / 库存 / 品类 / 定价 / ERP 状态统一）===
# 不设时默认 0.10（10%）。可写小数或大于 1 的百分数，例如 12 表示 12%。
# ECOMMERCE_HIGH_RETURN_RATE=0.10
# ECOMMERCE_HIGH_RETURN_RATE=12
